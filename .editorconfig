# [File Format Details](https://editorconfig.org/#file-format-details)
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
# 目前所有都是 crlf
end_of_line = crlf

[layouts/**]
# 主题文件未格式化 保持原样避免合并问题
insert_final_newline = false
trim_trailing_whitespace = false
